# Public Expo configuration. Copy this file to .env and fill in local values.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_AGORA_APP_ID=

# Development fixture calls only. Never enables production settlement.
EXPO_PUBLIC_ENABLE_CALL_SIMULATOR=false

# Never add AGORA_APP_CERTIFICATE or other server secrets to this file.
