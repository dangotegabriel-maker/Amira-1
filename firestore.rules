rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function approvedHost(data) { return data.get('hostStatus', {}).get('isApproved', false) == true; }
    function consumer(data) { return !approvedHost(data); }
    function participant(data) { return signedIn() && request.auth.uid in data.participantIds; }
    function otherUid(data) { return data.participantIds[0] == request.auth.uid ? data.participantIds[1] : data.participantIds[0]; }
    function blockedBetween(firstUid, secondUid) {
      return exists(/databases/$(database)/documents/users/$(firstUid)/blocked/$(secondUid))
        || exists(/databases/$(database)/documents/users/$(secondUid)/blocked/$(firstUid));
    }
    function rateUnchanged() { return request.resource.data.get('hostProfile', {}).get('videoRateCredits', 25) == resource.data.get('hostProfile', {}).get('videoRateCredits', 25) && request.resource.data.get('hostProfile', {}).get('rateTier', 'ENTRY') == resource.data.get('hostProfile', {}).get('rateTier', 'ENTRY'); }
    function levelFieldsAbsentOrUnchanged() { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['level','amiraLevel','lifetimeQualifyingPurchasedCredits']); }
    function financialFieldsUnchanged() { return request.resource.data.wallet == resource.data.wallet && request.resource.data.earnings == resource.data.earnings; }
    function approvalUnchanged() { return request.resource.data.get('hostStatus', {}).get('isApproved', false) == resource.data.get('hostStatus', {}).get('isApproved', false); }
    function vipUnchanged() { return request.resource.data.vip == resource.data.vip; }
    function visitorStatsUnchanged() { return request.resource.data.profileViewStats == resource.data.profileViewStats; }
    function referralRewardsUnchanged() { return request.resource.data.referralStats == resource.data.referralStats; }
    function canReadVisitorIdentities(uid) { return approvedHost(get(/databases/$(database)/documents/users/$(uid)).data); }
    function validApplicantUpdate() {
      return consumer(resource.data) && request.resource.data.role == 'consumer'
        && request.resource.data.hostStatus.diff(resource.data.get('hostStatus', {})).affectedKeys().hasOnly(['hasApplied', 'verificationStatus', 'availability'])
        && request.resource.data.hostStatus.hasApplied == true
        && request.resource.data.hostStatus.verificationStatus == 'pending'
        && request.resource.data.hostStatus.availability == 'offline'
        && getAfter(/databases/$(database)/documents/hostApplications/$(request.auth.uid)).data.status == 'submitted';
    }
    function safeRoleUpdate() { return request.resource.data.role == resource.data.role || (consumer(resource.data) && request.resource.data.role == 'consumer'); }
    function validReadUpdate() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadCounts', 'lastReadAt', 'updatedAt']) && request.resource.data.unreadCounts[request.auth.uid] == 0 && request.resource.data.unreadCounts[otherUid(resource.data)] == resource.data.unreadCounts[otherUid(resource.data)] && request.resource.data.lastReadAt.get(otherUid(resource.data), null) == resource.data.lastReadAt.get(otherUid(resource.data), null); }
    function validMessageCreate() { return request.resource.data.unreadCounts[request.auth.uid] == 0 && request.resource.data.unreadCounts[otherUid(request.resource.data)] == 1; }
    function validEmptyConversationCreate() { return request.resource.data.lastMessage == null && request.resource.data.unreadCounts[request.auth.uid] == 0 && request.resource.data.unreadCounts[otherUid(request.resource.data)] == 0; }
    function validMessageUpdate() { return request.resource.data.unreadCounts[request.auth.uid] == 0 && request.resource.data.unreadCounts[otherUid(resource.data)] == resource.data.unreadCounts[otherUid(resource.data)] + 1 && request.resource.data.lastReadAt[otherUid(resource.data)] == resource.data.lastReadAt[otherUid(resource.data)] && request.resource.data.lastMessageAt == request.time; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if owns(uid) && request.resource.data.uid == uid && request.resource.data.role == 'consumer' && !request.resource.data.keys().hasAny(['level','amiraLevel','lifetimeQualifyingPurchasedCredits']) && request.resource.data.hostStatus.isApproved == false && request.resource.data.get('hostProfile', {}).get('videoRateCredits',25) == 25 && request.resource.data.get('hostProfile', {}).get('rateTier','ENTRY') == 'ENTRY' && request.resource.data.wallet.creditBalance == 0 && request.resource.data.earnings.pending == 0 && request.resource.data.earnings.available == 0 && request.resource.data.vip.tier == 'FREE' && request.resource.data.vip.status == 'inactive' && request.resource.data.profileViewStats.recentCount == 0 && request.resource.data.referralStats.qualifiedCount == 0 && request.resource.data.referralStats.pendingCount == 0;
      allow update: if admin() || (owns(uid) && financialFieldsUnchanged() && levelFieldsAbsentOrUnchanged() && rateUnchanged() && approvalUnchanged() && vipUnchanged() && visitorStatsUnchanged() && referralRewardsUnchanged() && safeRoleUpdate() && (request.resource.data.hostStatus == resource.data.hostStatus || validApplicantUpdate()));
      allow delete: if false;

      match /following/{targetUid} {
        function validRelationship() {
          let source = get(/databases/$(database)/documents/users/$(uid)).data;
          let target = get(/databases/$(database)/documents/users/$(targetUid)).data;
          let data = request.resource.data;
          return (consumer(source) && approvedHost(target)
              && data.keys().hasOnly(['consumerId', 'hostId', 'createdAt'])
              && data.consumerId == uid && data.hostId == targetUid)
            || (approvedHost(source) && consumer(target)
              && data.keys().hasOnly(['sourceId', 'targetId', 'sourceRole', 'targetRole', 'createdAt'])
              && data.sourceId == uid && data.targetId == targetUid
              && data.sourceRole == 'host' && data.targetRole == 'consumer');
        }
        allow get: if owns(uid) || owns(targetUid);
        allow list: if owns(uid);
        allow create: if owns(uid) && uid != targetUid
          && request.resource.data.createdAt == request.time
          && !blockedBetween(uid, targetUid) && validRelationship();
        allow delete: if owns(uid);
        allow update: if false;
      }
      match /blocked/{blockedUid} {
        allow read: if owns(uid) || owns(blockedUid);
        allow create: if owns(uid) && blockedUid != uid && request.resource.data.blockedUid == blockedUid && request.resource.data.createdAt == request.time;
        allow delete: if owns(uid);
        allow update: if false;
      }
      match /likes/{consumerUid} {
        allow read: if (owns(uid) || owns(consumerUid)) && !blockedBetween(uid, consumerUid);
        allow write: if false; // Authenticated, role-checked transactional Like callable only.
      }
      match /discoveryHidden/{hostUid} {
        allow read: if owns(uid);
        allow write: if false; // Consumer-only discovery preference callable.
      }
      match /profileViews/{viewerUid} {
        allow read: if owns(uid) && canReadVisitorIdentities(uid);
        allow create, update: if false; // Trusted profile-view transaction only.
        allow delete: if owns(uid);
      }
      match /notices/{noticeId} {
        allow read: if owns(uid);
        allow create, delete: if admin();
        allow update: if admin() || (owns(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']) && request.resource.data.isRead == true);
      }
      match /entitlements/{entitlementId} {
        allow read: if owns(uid);
        allow write: if admin();
      }
    }

    // Only the recipient host can query incoming consumer follow records.
    // Writes remain restricted to the owned users/{uid}/following path above.
    match /{path=**}/following/{targetUid} {
      allow read: if signedIn() && resource.data.hostId == request.auth.uid
        && approvedHost(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }

    match /{path=**}/blocked/{blockedUid} {
      allow read: if signedIn() && resource.data.blockedUid == request.auth.uid;
    }
    match /presence/{uid} {
      allow read: if signedIn();
      allow create: if owns(uid) && request.resource.data.uid == uid && request.resource.data.state in ['online', 'offline'];
      allow update: if owns(uid) && request.resource.data.uid == uid && request.resource.data.state in ['online', 'offline'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'state', 'lastSeenAt', 'updatedAt']);
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if participant(resource.data);
      allow create: if false; // Trusted atomic send / friendship event only.
      allow update: if participant(resource.data) && validReadUpdate();
      allow delete: if false;

      match /messages/{messageId} {
        function parentAfter() { return getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data; }
        allow read: if participant(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow create: if false; // Entitlement consumption cannot be bypassed.
        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid && request.resource.data.reportedUserId != request.auth.uid && request.resource.data.status == 'submitted' && request.resource.data.createdAt == request.time;
      allow read: if admin();
      allow update, delete: if admin();
    }
    match /callHistory/{callId} {
      allow read: if participant(resource.data);
      allow create, update: if admin();
      allow delete: if false;
    }
    match /calls/{callId} {
      allow read: if participant(resource.data);
      allow create, update: if admin();
      allow delete: if false;
    }
    match /activeCallLocks/{uid} {
      allow read, write: if admin();
    }
    match /creditTransactions/{transactionId} {
      allow read: if signedIn() && request.auth.uid in [resource.data.consumerId, resource.data.creatorId];
      allow write: if admin();
    }
    // Private economy documents. Admin SDK transactions bypass client rules;
    // ordinary clients can never award rewards or author accounting splits.
    match /consumerRewards/{uid} {
      allow read: if owns(uid) && consumer(get(/databases/$(database)/documents/users/$(uid)).data);
      allow write: if false;
      match /chatWindows/{conversationId} {
        allow read: if owns(uid);
        allow write: if false;
      }
      match /messageTransactions/{transactionId} {
        allow read: if owns(uid) && consumer(get(/databases/$(database)/documents/users/$(uid)).data);
        allow write: if false;
      }
      match /claims/{dateKey} {
        allow read: if owns(uid) && consumer(get(/databases/$(database)/documents/users/$(uid)).data);
        allow write: if false;
      }
    }
    match /hostReputation/{hostUid} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /callReviews/{reviewId} {
      allow read: if signedIn() && request.auth.uid == resource.data.reviewerUid;
      allow write: if false;
    }
    match /friendships/{pairId} {
      allow read: if participant(resource.data);
      allow write: if false;
    }
    match /consumerLevels/{uid} {
      allow read: if owns(uid) && consumer(get(/databases/$(database)/documents/users/$(uid)).data);
      allow write: if false;
      match /milestoneClaims/{level} {
        allow read: if owns(uid) && consumer(get(/databases/$(database)/documents/users/$(uid)).data);
        allow write: if false;
      }
      match /qualifyingPurchases/{purchaseId} {
        allow read: if owns(uid) && consumer(get(/databases/$(database)/documents/users/$(uid)).data);
        allow write: if false;
      }
    }
    match /levelConfig/{documentId} { allow read, write: if false; }
    match /hostEarnings/{uid} {
      allow read: if admin() || (owns(uid) && approvedHost(get(/databases/$(database)/documents/users/$(uid)).data));
      allow write: if false;
    }
    match /platformRevenue/{documentId} {
      allow read: if admin();
      allow write: if false;
    }
    match /economyConfig/{documentId} {
      allow read: if admin();
      allow write: if false;
    }
    match /hostApplications/{uid} {
      allow read: if owns(uid) || admin();
      function applicant() { return owns(uid) && consumer(get(/databases/$(database)/documents/users/$(uid)).data); }
      function applicationPayload() { return request.resource.data.ownerUid == uid && request.resource.data.status in ['in_progress', 'submitted']; }
      allow create: if applicant() && applicationPayload() && request.resource.data.keys().hasOnly(['ownerUid','status','details','media','verification','payoutSetup','updatedAt','submittedAt']);
      allow update: if applicant() && applicationPayload()
        && resource.data.status in ['draft','in_progress','incomplete','rejected','needs_changes','action_required']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid','status','details','media','verification','payoutSetup','updatedAt','submittedAt']);
      allow update, delete: if admin();
    }
  }
}
