rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function approvedHost(data) {
      return data.role == 'host' && data.hostStatus.isApproved == true;
    }
    function financialFieldsUnchanged() {
      return request.resource.data.wallet == resource.data.wallet
        && request.resource.data.earnings == resource.data.earnings;
    }
    function approvalUnchanged() {
      return request.resource.data.hostStatus.isApproved == resource.data.hostStatus.isApproved;
    }
    function validHostApplicationTransition() {
      return resource.data.role != 'host'
        && request.resource.data.role == 'host'
        && request.resource.data.hostStatus.hasApplied == true
        && request.resource.data.hostStatus.isApproved == false
        && request.resource.data.hostStatus.verificationStatus == 'pending'
        && request.resource.data.hostStatus.availability == 'offline';
    }
    function validAvailabilityChange() {
      return approvedHost(resource.data)
        && request.resource.data.role == resource.data.role
        && request.resource.data.hostStatus.isApproved == resource.data.hostStatus.isApproved
        && request.resource.data.hostStatus.hasApplied == resource.data.hostStatus.hasApplied
        && request.resource.data.hostStatus.verificationStatus == resource.data.hostStatus.verificationStatus
        && request.resource.data.hostStatus.availability in ['offline', 'online', 'busy'];
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.hostStatus.isApproved == false
        && request.resource.data.wallet.creditBalance == 0
        && request.resource.data.earnings.pending == 0
        && request.resource.data.earnings.available == 0;
      allow update: if admin() || (owns(uid)
        && financialFieldsUnchanged()
        && approvalUnchanged()
        && (request.resource.data.role == resource.data.role
          || validHostApplicationTransition())
        && (request.resource.data.hostStatus == resource.data.hostStatus
          || validHostApplicationTransition()
          || validAvailabilityChange()));
      allow delete: if false;

      match /following/{hostId} {
        allow read: if owns(uid);
        allow create: if owns(uid)
          && request.resource.data.consumerId == uid
          && request.resource.data.hostId == hostId
          && approvedHost(get(/databases/$(database)/documents/users/$(hostId)).data);
        allow delete: if owns(uid);
        allow update: if false;
      }
    }

    match /hostApplications/{uid} {
      allow read: if owns(uid) || admin();
      allow create, update: if owns(uid)
        && request.resource.data.ownerUid == uid
        && request.resource.data.status in ['in_progress', 'submitted'];
      allow update, delete: if admin();
    }
  }
}
