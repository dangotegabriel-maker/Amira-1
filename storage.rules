rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    function admin() { return request.auth != null && request.auth.token.get('admin', false) == true; }
    // Fail closed when the authoritative application/profile cannot be read.
    // Uses the existing two Firestore documents; no Function or new service.
    function editableVerification(uid) {
      let profile = firestore.get(/databases/(default)/documents/users/$(uid));
      let application = firestore.get(/databases/(default)/documents/hostApplications/$(uid));
      return profile != null && application != null
        && profile.data is map && application.data is map
        && profile.data.get('role', '') == 'consumer'
        && profile.data.get('hostStatus', {}) is map
        && profile.data.get('hostStatus', {}).get('isApproved', false) == false
        && application.data.get('ownerUid', '') == uid
        && application.data.get('status', '') in ['draft', 'in_progress', 'incomplete', 'rejected', 'needs_changes', 'action_required'];
    }

    function imageUnder8MB() { return request.resource.size <= 8 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)'); }
    function videoUnder40MB() { return request.resource.size <= 40 * 1024 * 1024 && request.resource.contentType.matches('video/(mp4|quicktime|webm)'); }

    match /users/{uid}/profile/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if owns(uid) && imageUnder8MB();
      allow delete: if owns(uid);
    }
    match /users/{uid}/gallery/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if owns(uid) && imageUnder8MB();
      allow delete: if owns(uid);
    }
    match /users/{uid}/intro-video/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if owns(uid) && videoUnder40MB();
      allow delete: if owns(uid);
    }
    match /users/{uid}/verification/{allPaths=**} {
      allow read: if owns(uid) || admin();
      allow create, update: if owns(uid) && editableVerification(uid) && imageUnder8MB();
      allow delete: if owns(uid) && editableVerification(uid);
    }
  }
}
