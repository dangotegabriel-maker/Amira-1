rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    function admin() { return request.auth != null && request.auth.token.admin == true; }
    function imageUnder8MB() { return request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*'); }
    function videoUnder40MB() { return request.resource.size < 40 * 1024 * 1024 && request.resource.contentType.matches('video/.*'); }

    match /users/{uid}/profile/{fileName} {
      allow read: if request.auth != null;
      allow write: if owns(uid) && imageUnder8MB();
    }
    match /users/{uid}/gallery/{fileName} {
      allow read: if request.auth != null;
      allow write: if owns(uid) && imageUnder8MB();
    }
    match /users/{uid}/intro-video/{fileName} {
      allow read: if request.auth != null;
      allow write: if owns(uid) && videoUnder40MB();
    }
    match /users/{uid}/verification/{allPaths=**} {
      allow read: if owns(uid) || admin();
      allow write: if owns(uid) && imageUnder8MB();
    }
  }
}
